# Database connection: PostgreSQL url (default: postgresql://budmon:budmon@postgres:5432/budmon)
BUDMON_DATABASE_URL=postgresql://budmon:ETpass922@postgres:5432/budmon
# Leave empty to generate a persistent secret in the data volume.
BUDMON_SECRET_KEY=
# Apple Developer > Certificates, Identifiers & Profiles > Keys
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.budmon.ios
# Path INSIDE the container. Mount your private key directory using compose.apns.yml.
APNS_KEY_PATH=/run/secrets/apns/AuthKey.p8
# Monitoring history: both limits apply per target.
BUDMON_LOG_MAX_PER_TARGET=1000
BUDMON_LOG_RETENTION_DAYS=7
# Background workload tuning. Defaults are suitable for PostgreSQL.
BUDMON_MONITOR_WORKERS=16
BUDMON_MONITOR_BATCH_SIZE=250
BUDMON_CERT_CHECK_INTERVAL_SECONDS=21600
BUDMON_PUSH_WORKERS=8
BUDMON_PUSH_BATCH_SIZE=500
BUDMON_PUSH_INTERVAL_SECONDS=2
BUDMON_PUSH_RETENTION_DAYS=30
BUDMON_RETENTION_INTERVAL_MINUTES=15
BUDMON_RETENTION_BATCH_SIZE=250
BUDMON_DB_POOL_MIN=2
BUDMON_DB_POOL_MAX=24
